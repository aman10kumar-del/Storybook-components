{
  "name": "@paytm-h5-common/paytm_common_ui",
  "version": "3.1.0",
  "homepage": ".",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@bitbucket.org/paytmteam/paytm-common-ui.git"
  },
  "publishConfig": {
    "releasesRegistry": "https://nexusartifactory.paytm.com/repository/h5-npm-releases/",
    "snapshotRegistry": "https://nexusartifactory.paytm.com/repository/h5-npm-snapshots/"
  },
  "main": "dist/commonComponents",
  "module": "dist/commonComponents-esm",
  "types": "dist/types/src/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/commonComponents-esm/index.js",
      "require": "./dist/commonComponents/index.js"
    },
    "./icons": "./dist/icons/index.js",
    "./icons/*": "./dist/icons/*",
    "./styles/*": "./dist/styles/*"
  },
  "typesVersions": {
    "*": {
      "icons": [
        "dist/icons/index.d.ts"
      ],
      "icons/*": [
        "dist/icons/*"
      ]
    }
  },
  "sideEffects": [
    "src/commonStyles/sass-generated/index.css",
    "dist/commonComponents-esm/styles/index-common.css",
    "dist/styles/index-common.css",
    "dist/styles/**/*.css",
    "dist/commonComponents-esm/index.js"
  ],
  "scripts": {
    "setup:prod": "npm run generate-styles && npm run generate-icons-list && npm run build-sass",
    "setup:dev": "npm run generate-styles && npm run generate-icons-list && npm run watch-sass",
    "prepare": "npm run setup:prod && rm -rf dist && rollup -c && npm run generate-types-for-icons",
    "storybook": "npm run setup:dev && storybook dev -p 6006",
    "build-storybook": "npm run setup:prod && rm -rf build-storybook build && storybook build -o build-storybook && npm run gzip-sb",
    "gzip-sb": "gzipper c -i js,css --output-file-format [filename].[ext] ./build-storybook ./build && cpy 'build-storybook/**/*' '!build-storybook/**/*.(js|css)' build --no-overwrite",
    "test-light-storybook": "PODS_THEME=light test-storybook --verbose",
    "test-dark-storybook": "PODS_THEME=dark test-storybook --verbose",
    "test-storybook": "npm run test-light-storybook && npm run test-dark-storybook",
    "update-light-snapshots": "PODS_THEME=light test-storybook -u",
    "update-dark-snapshots": "PODS_THEME=dark test-storybook -u",
    "test": "npm run ut && npm run test-storybook",
    "ut": "npm run setup:prod && react-app-rewired test --verbose --no-cache --watchAll=false",
    "ut:watch": "npm run ut -- --watchAll",
    "systematize": "npm install",
    "build-sass": "sass --no-source-map ./src/commonStyles/_commoncss.scss:./src/commonStyles/sass-generated/index.css ./src/commonStyles/_variables.scss:./src/commonStyles/sass-generated/variables.css",
    "watch-sass": "sass --no-source-map --watch ./src/commonStyles/_commoncss.scss:./src/commonStyles/sass-generated/index.css ./src/commonStyles/_variables.scss:./src/commonStyles/sass-generated/variables.css &",
    "generate-styles": "style-dictionary build --config style-dictionary.config.js",
    "generate-icons-list": "node scripts/generate-icons-list.js",
    "generate-types-for-icons": "tsc ./dist/icons/index.js ./dist/icons/**/*.js ./dist/icons/**/**/*.js --declaration --allowJs --emitDeclarationOnly --skipLibCheck",
    "lint": "eslint '**/*.{ts,tsx}'",
    "notify": "node scripts/slack-notify.js"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "files": [
    "dist/"
  ],
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.2",
    "@babel/preset-env": "^7.23.9",
    "@babel/preset-react": "^7.23.3",
    "@babel/preset-typescript": "^7.23.3",
    "@ironkinoko/rollup-plugin-styles": "^4.0.3",
    "@jeysal/storybook-addon-css-user-preferences": "^0.2.0",
    "@rollup/plugin-commonjs": "^23.0.2",
    "@rollup/plugin-image": "^3.0.1",
    "@rollup/plugin-node-resolve": "^15.0.1",
    "@rollup/plugin-replace": "^5.0.2",
    "@rollup/plugin-url": "^8.0.1",
    "@slack/webhook": "^6.1.0",
    "@storybook/addon-a11y": "^7.6.17",
    "@storybook/addon-actions": "^7.6.17",
    "@storybook/addon-essentials": "^7.6.17",
    "@storybook/addon-interactions": "^7.6.17",
    "@storybook/addon-links": "^7.6.17",
    "@storybook/addon-mdx-gfm": "^7.6.17",
    "@storybook/preset-scss": "^1.0.3",
    "@storybook/react": "^7.6.17",
    "@storybook/react-webpack5": "^7.6.17",
    "@storybook/test-runner": "^0.16.0",
    "@storybook/testing-library": "^0.0.13",
    "@storybook/theming": "^7.6.17",
    "@svgr/rollup": "^8.1.0",
    "@svgr/webpack": "^8.1.0",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^17.0.45",
    "@types/ramda": "^0.28.18",
    "@types/react": "^18.0.21",
    "@types/react-dom": "^18.0.6",
    "babel-loader": "^8.3.0",
    "compression-webpack-plugin": "^10.0.0",
    "copy-webpack-plugin": "^11.0.0",
    "cpy-cli": "^5.0.0",
    "css-loader": "^6.7.2",
    "eslint": "^8.20.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-import-resolver-webpack": "^0.13.2",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-jsx-a11y": "^6.6.0",
    "eslint-plugin-react": "^7.30.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-storybook": "^0.8.0",
    "gzipper": "^7.2.0",
    "jest": "^29.6.4",
    "jest-environment-node": "^29.6.4",
    "jest-image-snapshot": "^6.4.0",
    "jest-runner": "^29.6.4",
    "md-2-json": "^2.0.0",
    "mini-css-extract-plugin": "^2.6.1",
    "node-sass": "^7.0.1",
    "preload-webpack-plugin": "^3.0.0-beta.3",
    "react": "^18.2.0",
    "react-app-rewired": "^2.2.1",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "rollup": "^3.3.0",
    "rollup-plugin-copy": "^3.4.0",
    "rollup-plugin-delete": "^2.0.0",
    "rollup-plugin-multi-input": "^1.3.2",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-typescript2": "^0.34.1",
    "sass": "^1.56.1",
    "sass-loader": "^13.2.0",
    "storybook": "^7.6.17",
    "style-dictionary": "^3.7.1",
    "style-loader": "^3.3.1",
    "terser-webpack-plugin": "^5.3.3",
    "typed-scss-modules": "^7.0.0",
    "typescript": "^4.8.4",
    "url-loader": "^4.1.1"
  },
  "jest": {
    "collectCoverage": true,
    "coverageDirectory": "test-coverage",
    "collectCoverageFrom": [
      "/src/pods-components/.*"
    ],
    "coveragePathIgnorePatterns": [
      ".*types.*",
      ".*stories.*",
      "/src/index.ts",
      "/src/pods-components/index.ts",
      "/src/pods-components/Color/.*",
      "/src/pods-components/Header/HeaderSBArgTypes.ts",
      "src/utils/.*"
    ]
  },
  "dependencies": {
    "@szhsin/react-menu": "^4.1.0"
  }
}
